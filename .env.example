# =============================================================================
# Configuration de developpement — a copier en .env
#
#   cp .env.example .env
#
# Le .env n'est pas versionne (voir .gitignore). Ce fichier en est le modele.
# Les surcharges specifiques a l'environnement vont dans .env.dev / .env.local.
# =============================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
# Generer avec : php -r 'echo bin2hex(random_bytes(16));'
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# MariaDB fournie par compose.yaml (creds db/db/db)
DATABASE_URL="mysql://db:db@127.0.0.1:3306/db?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Passphrase choisie lors de : php bin/console lexik:jwt:generate-keypair
JWT_PASSPHRASE=
JWT_TOKEN_TTL=3600
###< lexik/jwt-authentication-bundle ###

###> Versions client mobile ###
APP_VERSION_LATEST=2.0.0
APP_VERSION_MIN=1.0.0
APP_STORE_IOS_URL=http://localhost
APP_STORE_ANDROID_URL=http://localhost
###< Versions client mobile ###

###> Taches planifiees ###
# Jeton attendu par les endpoints cron. Generer une valeur aleatoire.
APP_CRON_SECRET=
###< Taches planifiees ###

###> symfony/mailer ###
# En dev, Mailpit est expose par compose.yaml (UI sur le port 8025)
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_FROM=contact@antoninpamart.fr
MAILER_FROM_NAME="Les Marmottes"
###< symfony/mailer ###

###> Front ###
APP_WEB_URL=http://localhost:5173
###< Front ###
